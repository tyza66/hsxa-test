# hsxa 环境变量样例。复制为 .env 后按需填写，.env 已被 .gitignore 忽略。
#
# 全部配置都有默认值，最小可用集合是 MODEL_NAME 加一组模型凭据。

# ---------- 模型 ----------
# 供应商，当前仅支持 ark（火山方舟）
MODEL_PROVIDER=ark
# 必填：接入点名称 / 模型 ID
MODEL_NAME=
# 二选一：Ark API Key；或同时提供 AccessKey 与 SecretKey
MODEL_API_KEY=
MODEL_ACCESS_KEY=
MODEL_SECRET_KEY=
# 可选：覆盖默认域名与区域，一般留空即可
MODEL_BASE_URL=
MODEL_REGION=
# 可选：采样参数与配额，留空表示用模型默认值
MODEL_TEMPERATURE=
MODEL_TOP_P=
MODEL_MAX_TOKENS=
MODEL_RETRY_TIMES=
# 单次模型调用超时，Go duration 语法，如 90s、5m
MODEL_TIMEOUT=

# ---------- 智能体 ----------
# true 时请求走 ReAct 智能体链路，false 时直连 ChatModel
AGENT_ENABLED=false
# 智能体单次请求的最大工具调用轮数
AGENT_MAX_STEP=12
# 系统人设
AGENT_PERSONA=You are a helpful assistant. Reply in the language the user writes in.

# ---------- HTTP 服务 ----------
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
SERVER_READ_TIMEOUT=15s
SERVER_WRITE_TIMEOUT=10m
SERVER_SHUTDOWN_TIMEOUT=10s

# ---------- 日志 ----------
# debug / info / warn / error
LOG_LEVEL=info
# text / json
LOG_FORMAT=text
